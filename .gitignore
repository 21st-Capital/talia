# Phones for scripts/ios-device.sh, one "name=udid" per line. Device ids are
# personal data and never go into the repository (decided 2026-09-26).
.devices.local

# Xcode derived data for direct device builds (scripts/ios-device.sh)
ios/build-device/
native/bitboxffi/lib/

# Simulator build products (scripts: xcodebuild -sdk iphonesimulator -derivedDataPath ios/build-sim)
ios/build-sim/

# Worktrees nested in the checkout (parallel builds)
.claude/worktrees/

# Reports of the simulator harness (scripts/tier-c/run.py); written per run, never committed.
scripts/tier-c/out/
